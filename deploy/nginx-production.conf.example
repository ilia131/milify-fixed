# Install on the proxy host. The application ports are private listeners.
server {
    listen 80;
    server_name milify.ir api.milify.ir;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.milify.ir;
    ssl_certificate /etc/letsencrypt/live/api.milify.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.milify.ir/privkey.pem;
    client_max_body_size 128m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl;
    server_name milify.ir;
    ssl_certificate /etc/letsencrypt/live/milify.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/milify.ir/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
